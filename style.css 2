body{
font-family:Arial;
margin:0;
background:#f2f2f2;
}


header{
background:#ff6600;
padding:20px;
color:white;
text-align:center;
}


input{
width:90%;
padding:12px;
border-radius:20px;
border:none;
}


.categorias{
padding:15px;
}


.categorias button{
padding:10px;
margin:5px;
border:none;
border-radius:20px;
}


.banner{
background:white;
margin:15px;
padding:30px;
border-radius:15px;
}


.titulo{
padding-left:15px;
}


.produtos{
display:grid;
grid-template-columns:repeat(2,1fr);
gap:15px;
padding:15px;
}


.card{
background:white;
padding:15px;
border-radius:15px;
}


.card img{
width:100%;
}


.preco{
color:#ff6600;
font-size:20px;
font-weight:bold;
}


.card button{
background:#ff6600;
color:white;
border:none;
padding:10px;
width:100%;
border-radius:10px;
}